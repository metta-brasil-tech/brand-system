# Não sobe pro deploy Vercel — pesa bundle e não é runtime.
node_modules
.venv
.venv-indexer
__pycache__
*.pyc

# render_out/ = saídas de teste (decks, PDFs, previews, galerias, vídeo).
# 168 MB versionados que estouravam o limite de 225 MB da função. Nada de runtime lê daqui.
render_out

# Engine submodule — só rastreia o que importa pra runtime
engine/.git
engine/.venv
engine/__pycache__
engine/artifacts
engine/tests
engine/scripts
engine/brand-knowledge/exemplars
engine/Dockerfile
engine/docker-compose.yml
engine/telegram_bot.py
engine/demo.py
engine/indexer.py

# NÃO excluir source/ — build.mjs lê os .md de source/ no momento do build Vercel
# pra gerar os HTMLs em content/<tab>/<sec>.html. Excluir = build quebra.
