{
  "name": "metta-brand-system",
  "version": "1.0.0",
  "description": "Mini-app que reúne estratégia, audiência, identidade verbal/visual, direção de arte, produtos e aplicações da Metta.",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "npx --yes serve -p 5173 --no-clipboard -c serve.json .",
    "build": "node scripts/build.mjs && node scripts/build-docs-manifest.mjs",
    "build:content": "node scripts/build.mjs",
    "build:manifest": "node scripts/build-docs-manifest.mjs",
    "build:full": "node scripts/build.mjs --full && node scripts/build-docs-manifest.mjs"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "marked": "^12.0.2",
    "sharp": "^0.33.0"
  }
}
