{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": ".",
  "installCommand": "npm install",
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/auth/:action",
      "destination": "/api/auth?action=:action"
    },
    {
      "source": "/api/solicitacoes/:action",
      "destination": "/api/solicitacoes?action=:action"
    }
  ],
  "functions": {
    "api/auth.js": {
      "maxDuration": 15,
      "excludeFiles": "{assets,content,source,node_modules,vendor,scripts,styles,embed,public,engine,agente-copy,render_out,data,prototipos,docs,artifacts,out}/**"
    },
    "api/generate.py": {
      "maxDuration": 60,
      "memory": 1769,
      "includeFiles": "{engine/brand-knowledge/**,source/ad-templates/**,source/ad-blueprints/**,data/curated-references.json}",
      "excludeFiles": "{assets,content,source/embed,source/metta,source/design,source/compartilhado,source/transcricoes,source/brain,source/tiago,source/work,source/arquitetura,source/arquivo,source/tools,node_modules,vendor,scripts,styles,public,agente-copy}/**"
    },
    "api/image-search.py": {
      "maxDuration": 15,
      "excludeFiles": "{assets,content,source,node_modules,vendor,scripts,styles,embed,data,public,engine,agente-copy,render_out}/**"
    },
    "api/pieces.py": {
      "maxDuration": 15,
      "excludeFiles": "{assets,content,source,node_modules,vendor,scripts,styles,embed,public,engine,agente-copy,render_out}/**"
    },
    "api/copy-agent.py": {
      "maxDuration": 300,
      "includeFiles": "{agente-copy/**}",
      "excludeFiles": "{assets,content,source,node_modules,vendor,scripts,styles,embed,public,engine,render_out}/**"
    },
    "api/prompt-image.py": {
      "maxDuration": 30,
      "includeFiles": "{engine/brand-knowledge/**,source/ad-blueprints/**}",
      "excludeFiles": "{assets,content,source/embed,source/metta,source/design,source/compartilhado,source/transcricoes,node_modules,vendor,scripts,styles,data,public,agente-copy,render_out}/**"
    },
    "api/preview.py": {
      "maxDuration": 10,
      "includeFiles": "{source/ad-blueprints/**}",
      "excludeFiles": "{assets,content,source/embed,source/metta,source/design,source/compartilhado,source/transcricoes,engine,node_modules,vendor,scripts,styles,data,public,agente-copy,render_out}/**"
    },
    "api/revoice.py": {
      "maxDuration": 30,
      "includeFiles": "{engine/adapters/**}",
      "excludeFiles": "{assets,content,source,node_modules,vendor,scripts,styles,embed,data,public,agente-copy,render_out}/**"
    },
    "api/render.js": {
      "memory": 1024,
      "maxDuration": 30
    },
    "api/save-creative.js": {
      "maxDuration": 30,
      "excludeFiles": "{assets,content,source,node_modules,vendor,scripts,styles,embed,public,engine,agente-copy,render_out,data}/**"
    },
    "api/creatives.js": {
      "maxDuration": 15,
      "includeFiles": "data/generated-index.json",
      "excludeFiles": "{assets,content,source,vendor,scripts,styles,embed,public,engine,agente-copy,render_out}/**"
    },
    "api/solicitacoes.js": {
      "maxDuration": 30,
      "excludeFiles": "{assets,content,source,node_modules,vendor,scripts,styles,embed,public,engine,agente-copy,render_out,data,prototipos,docs,artifacts,out}/**"
    }
  }
}