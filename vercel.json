{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": ".",
  "installCommand": "npm install",
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/generate.py": {
      "maxDuration": 60,
      "includeFiles": "engine/**",
      "excludeFiles": "{assets,content,source,node_modules,vendor,scripts,styles,embed,data,public}/**"
    },
    "api/image-search.py": {
      "maxDuration": 15,
      "excludeFiles": "{assets,content,source,node_modules,vendor,scripts,styles,embed,data,public,engine}/**"
    }
  }
}
