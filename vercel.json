{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": ".",
  "installCommand": "npm install",
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/generate.py": {
      "maxDuration": 60,
      "memory": 1769,
      "includeFiles": "{engine/brand-knowledge/**,source/ad-templates/**,source/ad-blueprints/**,assets/symbols/**,assets/tiago/**}",
      "excludeFiles": "{assets/applications,assets/fotografia,assets/generated,assets/icons,assets/logos,assets/modelos-documentos,assets/photo-presets,assets/signatures,assets/style-previews,content,source/embed,source/metta,source/design,source/compartilhado,source/transcricoes,source/brain,source/tiago,source/work,source/arquitetura,source/arquivo,source/tools,node_modules,vendor,scripts,styles,data,public,agente-copy}/**"
    },
    "api/image-search.py": {
      "maxDuration": 15,
      "excludeFiles": "{assets/applications,assets/fotografia,assets/generated,assets/icons,assets/logos,assets/modelos-documentos,assets/photo-presets,assets/signatures,assets/style-previews,content,source,node_modules,vendor,scripts,styles,embed,data,public,engine,agente-copy,render_out}/**"
    },
    "api/pieces.py": {
      "maxDuration": 15,
      "excludeFiles": "{assets/applications,assets/fotografia,assets/generated,assets/icons,assets/logos,assets/modelos-documentos,assets/photo-presets,assets/signatures,assets/style-previews,content,source,node_modules,vendor,scripts,styles,embed,public,engine,agente-copy,render_out}/**"
    },
    "api/copy-agent.py": {
      "maxDuration": 300,
      "includeFiles": "{agente-copy/**}",
      "excludeFiles": "{assets/applications,assets/fotografia,assets/generated,assets/icons,assets/logos,assets/modelos-documentos,assets/photo-presets,assets/signatures,assets/style-previews,content,source,node_modules,vendor,scripts,styles,embed,public,engine,render_out}/**"
    },
    "api/prompt-image.py": {
      "maxDuration": 30,
      "includeFiles": "{engine/brand-knowledge/**,source/ad-blueprints/**}",
      "excludeFiles": "{assets/applications,assets/fotografia,assets/generated,assets/icons,assets/logos,assets/modelos-documentos,assets/photo-presets,assets/signatures,assets/style-previews,content,source/embed,source/metta,source/design,source/compartilhado,source/transcricoes,node_modules,vendor,scripts,styles,data,public,agente-copy,render_out}/**"
    },
    "api/preview.py": {
      "maxDuration": 10,
      "includeFiles": "{source/ad-blueprints/**,assets/symbols/**,assets/tiago/**}",
      "excludeFiles": "{assets/applications,assets/fotografia,assets/generated,assets/icons,assets/logos,assets/modelos-documentos,assets/photo-presets,assets/signatures,assets/style-previews,content,source/embed,source/metta,source/design,source/compartilhado,source/transcricoes,engine,node_modules,vendor,scripts,styles,data,public,agente-copy,render_out}/**"
    },
    "api/render.js": {
      "memory": 1024,
      "maxDuration": 30
    },
    "api/save-creative.js": {
      "maxDuration": 30,
      "excludeFiles": "{assets/applications,assets/fotografia,assets/generated,assets/icons,assets/logos,assets/modelos-documentos,assets/photo-presets,assets/signatures,assets/style-previews,content,source,node_modules,vendor,scripts,styles,embed,public,engine,agente-copy,render_out,data}/**"
    },
    "api/creatives.js": {
      "maxDuration": 15,
      "includeFiles": "data/generated-index.json",
      "excludeFiles": "{assets/applications,assets/fotografia,assets/generated,assets/icons,assets/logos,assets/modelos-documentos,assets/photo-presets,assets/signatures,assets/style-previews,content,source,vendor,scripts,styles,embed,public,engine,agente-copy,render_out}/**"
    }
  }
}
